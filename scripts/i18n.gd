static var _lang := ""

static func lang() -> String:
	if _lang == "":
		_lang = "zh" if OS.get_locale_language().begins_with("zh") else "en"
	return _lang

static func T(key: String) -> String:
	var table: Dictionary = STR[lang()]
	if table.has(key):
		return table[key]
	return STR["en"].get(key, key)
